# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local postgres data directory (see docs/local-postgres.md)
/pgdata

# ingestion outputs (e.g. downloaded heat-intelligence PDFs)
/outputs

# per-run pipeline logs (see lib/ingestion/spawnPipeline.ts)
/logs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client
/lib/generated/prisma
