# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Database --------------------------------------------------------------
# Local dev default matches docs/local-postgres.md (native Postgres cluster
# under ./pgdata, running on port 5433 to avoid clashing with any existing
# local Postgres install on the default 5432 port):
# DATABASE_URL="postgresql://herdsafe@127.0.0.1:5433/herdsafe"
#
# Production (Supabase) uses two URLs instead of one — see prisma.config.ts
# and lib/db.ts for why:
#
# DATABASE_URL: the POOLED connection (PgBouncer/Supavisor, port 6543) —
# used by the app at runtime for all normal query traffic.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: the DIRECT connection (port 5432, no pooler) — used only by
# the Prisma CLI (migrate/generate/studio). PgBouncer's transaction-pooling
# mode doesn't support the prepared statements Prisma Migrate needs.
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# --- FortyGuard API --------------------------------------------------------
# Required. Get this from your FortyGuard dashboard. Never expose this to the
# client — it is only ever read server-side (scripts/ and lib/fortyguard/).
FORTYGUARD_API_KEY=your_api_key_here

# Optional — override the default production base URL.
# Development: https://tos-enterprise-api.dev.app.fortyguard.com
# Production:  https://api.fortyguard.com
FORTYGUARD_BASE_URL=https://api.fortyguard.com
